{
  "layer": "top",
  "position": "top",
  "height": 54,
  "modules-left": [
    "custom/rofi",
    "hyprland/workspaces",
    "custom/media",
    "custom/weather"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/updates",
    "custom/storage",
    "cpu",
    "memory",
    "idle_inhibitor",
    "pulseaudio",
    "custom/keyboard",
    "tray",
    "custom/power"
  ],
  "custom/rofi": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },
  "custom/terminal": {
    "format": "",
    "tooltip": false,
    "on-click": "kitty"
  },
  "custom/firefox": {
    "format": "",
    "tooltip": false,
    "on-click": "cachy-browser"
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "format": "{id}",
    "all-outputs": true
  },
  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "tooltip-format": "<big>{:%A, %B %d %Y}</big>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month"
    }
  },
  "custom/keyboard": {
    "format": "",
    "tooltip": "On-Screen Keyboard",
    "on-click": "pgrep -x wvkbd-mobintl && pkill -x wvkbd-mobintl || wvkbd-mobintl &"
  },
  "custom/media": {
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/mediaplayer.py",
    "interval": 1,
    "format": "{}",
    "max-length": 45,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "escape": true
  },
  "custom/weather": {
    "return-type": "json",
    "interval": 900,
    "exec": "~/.config/waybar/scripts/weather.sh",
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open https://wttr.in",
    "on-click-right": "pkill -SIGRTMIN+10 waybar"
  },
  "cpu": {
    "interval": 1,
    "format": "󰍛  {usage}%"
  },
  "memory": {
    "interval": 30,
    "format": "󰘚  {used:0.1f}G"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pgrep -x pavucontrol && pkill -x pavucontrol || pavucontrol &"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "custom/storage": {
    "format": "{text}",
    "return-type": "json",
    "interval": 60,
    "exec": "~/.config/waybar/scripts/storage.sh"
  },
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 1800,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/update-menu.sh",
    "on-click-right": "kitty --hold sh -c 'yay && flatpak update'"
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}